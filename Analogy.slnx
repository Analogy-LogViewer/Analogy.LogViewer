<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="ARM" />
    <Platform Name="ARM64" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".github/dependabot.yml" />
    <File Path=".github/workflows/dotnet-core-desktop.yml" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="nuget.config" />
  </Folder>
  <Project Path="Analogy.Common/Analogy.Common.csproj">
    <Platform Solution="*|x64" Project="x64" />
    <Platform Solution="*|x86" Project="x86" />
  </Project>
  <Project Path="Analogy.CommonControls.Example/Analogy.CommonControls.Example.csproj">
    <BuildDependency Project="Analogy.Common/Analogy.Common.csproj" />
    <BuildDependency Project="Analogy.CommonControls/Analogy.CommonControls.csproj" />
    <Platform Solution="*|x64" Project="x64" />
    <Platform Solution="*|x86" Project="x86" />
  </Project>
  <Project Path="Analogy.CommonControls/Analogy.CommonControls.csproj">
    <Platform Solution="*|x64" Project="x64" />
    <Platform Solution="*|x86" Project="x86" />
  </Project>
  <Project Path="Analogy.UnitTests/Analogy.UnitTests.csproj">
    <BuildDependency Project="Analogy.Common/Analogy.Common.csproj" />
    <BuildDependency Project="Analogy.CommonControls/Analogy.CommonControls.csproj" />
    <Platform Solution="*|x64" Project="x64" />
    <Platform Solution="*|x86" Project="x86" />
    <Build Solution="*|ARM" Project="false" />
    <Build Solution="*|ARM64" Project="false" />
  </Project>
  <Project Path="Analogy/Analogy.csproj">
    <Platform Solution="*|x64" Project="x64" />
    <Platform Solution="*|x86" Project="x86" />
    <Build Solution="*|ARM" Project="false" />
    <Build Solution="*|ARM64" Project="false" />
  </Project>
</Solution>
